PORT=3000
HOST=127.0.0.1
# Para hospedagem atrás de proxy HTTPS, defina HOST=0.0.0.0 e SECURE_COOKIES=true.
SECURE_COOKIES=false
DATA_DIR=./data
CATALOG_FILE=./src/catalogo.json
SITE_FILE=./src/site.json
# Use file para prévias em data/emails, smtp para SMTP ou resend para API.
EMAIL_MODE=file
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=
# SMTP usa as credenciais do seu provedor de e-mail.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Destino opcional somente para npm run testar-email.
# Se ficar vazio, o teste usa ORDER_EMAIL_TO.
TEST_EMAIL_TO=
