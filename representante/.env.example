PORT=3000
HOST=127.0.0.1
# Para hospedagem atrás de proxy HTTPS, defina HOST=0.0.0.0 e SECURE_COOKIES=true.
SECURE_COOKIES=false
DATA_DIR=./data
CATALOG_FILE=./src/catalogo.json
# Use file para gravar os e-mails em data/emails ou resend para envio real.
EMAIL_MODE=file
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=
